{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cc-widget",
  "version": "0.1.2",
  "identifier": "io.github.theone55.cc-widget",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "cc-widget",
        "width": 300,
        "height": 40,
        "decorations": false,
        "resizable": true,
        "minWidth": 220,
        "minHeight": 40,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Claude Code sessions, context and limits at a glance",
    "longDescription": "A tiny always-on-top desktop widget for Claude Code: which sessions wait for your answer, how full each context window is, and how much of the 5-hour / 7-day limits each account has used.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico", "sidebarImage": "icons/installer-sidebar.bmp", "headerImage": "icons/installer-header.bmp" }
    }
  }
}
